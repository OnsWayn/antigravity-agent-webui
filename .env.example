# Bind on all interfaces so LAN clients can connect.
HOST=0.0.0.0
PORT=3000

# Local persistence and temporary snapshot cache.
ANTIGRAVITY_DB_PATH=./data/antigravity.db
SNAPSHOT_CACHE_DIR=./data/snapshot-cache
SNAPSHOT_CACHE_TTL_MS=60000

# Optional server-side proxy. You can also configure a proxy in the WebUI.
# HTTPS_PROXY=http://127.0.0.1:10808
# HTTP_PROXY=http://127.0.0.1:10808
# PROXY_URL=http://127.0.0.1:10808

# Optional comma-separated browser origins for a separately hosted frontend.
# The matching localhost and 127.0.0.1 origins are allowed automatically.
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gemini API keys for the WebUI are configured in the browser and should not be added here.

# Protocol gateway (optional). Downstream clients use custom ag- tokens.
# GATEWAY_ENABLED=true
# GATEWAY_MASTER_KEY=replace-with-a-long-random-string
# GATEWAY_ADMIN_TOKEN=replace-with-admin-secret
